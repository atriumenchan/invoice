# Copy to .env (local) and add the same keys in Vercel → Settings → Environment Variables.
# VITE_ keys are bundled into the client — only use the anon key here, never service keys.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Email of the super-admin account (approves invoices, manages users)
VITE_ADMIN_EMAIL=you@company.com

# Server-side only (used by /api serverless functions — never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAIL=you@company.com
DEEPSEEK_API_KEY=your-deepseek-key

# WhatsApp Cloud API (Meta) — ping this number when someone sends an invoice for approval.
# Create an app at https://developers.facebook.com → WhatsApp → API Setup.
# For production outbound alerts you must also create a template (see WHATSAPP_TEMPLATE_NAME).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=918586862674
# Optional. Template body variables in order: invoice number, sender email, client, total.
# WHATSAPP_TEMPLATE_NAME=invoice_approval
# WHATSAPP_TEMPLATE_LANG=en
